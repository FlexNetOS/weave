target/
/.weave-test/

# Local operator configuration. Keep the public schema/example tracked.
.env
.env.*
!.env.example

# ADR-0004 §3: per-repo .handoff carries NO ledger.db / no binary state in git.
# Guard against a local `hf claim/checkpoint` writing the ephemeral member ledger.
.handoff/ledger.db
.handoff/**/ledger.db
# Local upstream archives supplied for audit/integration evidence. Do not delete.
cc-switch-main.zip
.handoff/ledger.db-wal
.handoff/ledger.db-shm
.handoff/**/*.rvf
.handoff/**/*.rvf.lock
.handoff/ledger.db.sqlite.bak
.handoff/ledger.redb.tmp
.handoff/locks/
.handoff/run/
.handoff/workspaces/main/scratch/

# handoff continuity: binary ledger cache + migration artifacts are gitignored
# (committed truth = .handoff/ledger.events.jsonl — ADR-0018 D1 / HFTASK-0067)
.handoff/**/*.db-wal
.handoff/**/*.db-shm
.handoff/**/*.sqlite.bak
.handoff/**/*.redb.tmp

# local agent worktrees -- never part of the tree
.worktrees/
