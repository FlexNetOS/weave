# Weave environment example
#
# This file is tracked documentation, not a secret store. Copy only the variables
# you need into your own untracked environment manager. Keep every real token,
# private key, browser proxy credential, and live-test credential out of git.
#
# All assignments are commented so sourcing this file is a no-op until you
# deliberately uncomment a line.

## Core identity and storage

# Stable mesh identity. Set this for real sessions; a cwd-derived fallback is a
# guess and will not mark mail read.
# WEAVE_SESSION=desktop

# Visibility circle for peers/sessions/scan. Valid labels are ASCII identifiers.
# WEAVE_CIRCLE=default

# Storage backend: sqlite is the default build; libsql requires a libsql build.
# WEAVE_BACKEND=sqlite

# Local store path. For a remote libSQL backend this path is ignored.
# WEAVE_DB=/home/me/.local/share/weave/messages.db

# Remote libSQL/Turso endpoint and auth token. The token is secret.
# WEAVE_LIBSQL_URL=libsql://your-db.turso.io
# WEAVE_LIBSQL_AUTH_TOKEN=<secret-libsql-auth-token>

# SessionStart opportunistic GC age in seconds. 0 disables auto-GC.
# WEAVE_RETENTION_SECS=2592000

# Force one mux detector: tmux, zellij, wezterm, kitty, screen, or iterm2.
# WEAVE_MUX_PREFERENCE=tmux

## Host path and process context

# Normally inherited from the OS. Override only for isolated runs/tests.
# HOME=/home/me
# XDG_CONFIG_HOME=/home/me/.config
# XDG_DATA_HOME=/home/me/.local/share
# XDG_RUNTIME_DIR=/run/user/1000
# HOSTNAME=my-host
# PATH=/usr/local/bin:/usr/bin:/bin
# TMPDIR=/tmp

# Display without ANSI clear-home frames.
# WEAVE_NO_CLEAR=1
# NO_COLOR=1

## Mux detection and trusted mux binaries

# These are usually exported by the terminal/mux itself.
# TMUX_PANE=%1
# TMUX=/tmp/tmux-1000/default,12345,0
# ZELLIJ_SESSION_NAME=my-zellij
# ZELLIJ_PANE_ID=terminal_1
# WEZTERM_PANE=123
# KITTY_WINDOW_ID=42
# KITTY_LISTEN_ON=unix:/tmp/kitty
# STY=1234.pts-0.host
# TERM_PROGRAM=iTerm.app
# TERM_SESSION_ID=w0t0p0

# Extra absolute trusted directories for tmux/zellij/kitty/wezterm/screen and
# other trusted child programs. Relative entries are ignored.
# WEAVE_MUX_DIR=/home/me/.local/bin:/nix/profile/bin

## Federation, pull delivery, and push delivery

# Read-only visibility stores for peers/sessions.
# WEAVE_PEER_DBS=/path/to/other/messages.db,PROD=libsql://prod.turso.io

# Delivery sources this session pulls from into its own inbox.
# WEAVE_PULL_FROM=/path/to/sender/messages.db,PROD=libsql://prod.turso.io

# Shared remote read token and optional per-source token. Tokens are secret.
# WEAVE_PULL_TOKEN=<secret-shared-read-token>
# WEAVE_PULL_TOKEN_PROD=<secret-prod-read-token>
# WEAVE_PULL_TOKEN_<LABEL>=<secret-per-source-read-token>

# Remote connect/read timeout in ms. Per-source labels share the token namespace.
# WEAVE_PULL_TIMEOUT_MS=5000
# WEAVE_PULL_TIMEOUT_MS_PROD=250
# WEAVE_PULL_TIMEOUT_MS_<LABEL>=250

# Whether pulled delivery also sends this session a content-free live nudge.
# WEAVE_INJECT_PULLED=true

# Optional narrower subset of pull sources allowed to trigger a live nudge.
# WEAVE_ALLOW_INJECT_FROM=/path/to/sender/messages.db,PROD=libsql://prod.turso.io

# Push-only token for POST /push. Must differ from the operator web token.
# WEAVE_PUSH_TOKEN=<secret-push-only-token>

# Convenience shell variable used in docs for --token; Weave does not read this
# name automatically. Pass it explicitly: weave dashboard --token "$WEAVE_ADMIN_TOKEN".
# WEAVE_ADMIN_TOKEN=<secret-operator-token>

## Signing and verification

# Private signing keys are not configured by env. Use `weave key gen`; the private
# key is stored under the Weave config dir with 0600 permissions and is never
# printed. Receiver policy is configured here:
# WEAVE_STRICT_VERIFY=true
# WEAVE_TRUST=SHA256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# WEAVE_REVOKED=SHA256:deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

## Optional LLM summarization

# Requires a build with --features llm. The API key is secret.
# WEAVE_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# WEAVE_LLM_API_KEY=<secret-llm-api-key>
# WEAVE_LLM_MODEL=gpt-4o-mini
# WEAVE_LLM_TIMEOUT_SECS=30
# WEAVE_LLM_MAX_INPUT_CHARS=16000

## Telegram and Slack bridges

# Requires a build with --features surfaces. Tokens are secret. Use distinct
# platform identities when both bridges are enabled.
# WEAVE_TELEGRAM_TOKEN=<secret-telegram-bot-token>
# WEAVE_TELEGRAM_CHAT_ID=-1001234567890
# WEAVE_TELEGRAM_IDENTITY=telegram
# WEAVE_TELEGRAM_RECIPIENT=desktop
# WEAVE_TELEGRAM_BOT_USERNAME=my_weave_bot

# WEAVE_SLACK_TOKEN=<secret-slack-bot-token>
# WEAVE_SLACK_CHANNEL=C0123456789
# WEAVE_SLACK_IDENTITY=slack
# WEAVE_SLACK_RECIPIENT=desktop

# Legacy fallback identity for a single bridge. Prefer platform-specific
# identities above.
# WEAVE_BRIDGE_IDENTITY=legacy-bridge

# Explicitly enables bridge write commands (/send, /ask, /answer, /reply).
# WEAVE_BOT_WRITES=1

## Governed web access via Obscura

# Requires a build with --features obscura. Web ops are deny-by-default.
# WEAVE_OBSCURA_BIN=obscura
# WEAVE_OBSCURA_STEALTH=false

# Proxy URL must be credential-free because it is passed as argv to obscura.
# WEAVE_OBSCURA_PROXY=http://127.0.0.1:8080

# WEAVE_OBSCURA_USER_AGENT=Weave/obscura
# WEAVE_OBSCURA_TIMEOUT_SECS=30

# Comma-separated browser ops without the browser_ prefix, or * for all.
# WEAVE_OBSCURA_ALLOW_OPS=navigate,snapshot,extract

# Optional public-host allow-list for URL-bearing ops.
# WEAVE_OBSCURA_ALLOW_DOMAINS=example.com,.example.org

# Keep false unless internal/loopback/RFC1918 browser access is intended.
# WEAVE_OBSCURA_ALLOW_INTERNAL=false

## PreToolUse approval gate

# Used only when the host hook is installed with `weave setup --pretooluse`.
# Unset approver means deny-by-default for dangerous tools.
# WEAVE_PRETOOLUSE_APPROVER=desktop
# WEAVE_PRETOOLUSE_TIMEOUT_SECS=30

## MCP, HTTP, dashboard, daemon, and lifecycle hooks

# Restore the full flat MCP tools/list surface. Default is token-light.
# WEAVE_MCP_EAGER=1

# Presence daemon state and timing.
# WEAVE_PIDFILE=/run/user/1000/weave/weaved.pid
# WEAVE_DAEMON_HEARTBEAT_SECS=15
# WEAVE_DAEMON_EVICT_SECS=60
# WEAVE_DAEMON_EVICT_CUTOFF_SECS=30

# Stop hook wake mode: only use when the wake is the delivery.
# WEAVE_STOP_WAKE=1

# Optional hook one-shot responder ACK sweep.
# WEAVE_RESPONDER_ON_HOOK=1
# WEAVE_RESPONDER_STATUS=received

# Hook identity/liveness inputs. Usually supplied by the host wrapper.
# WEAVE_CLIENT_PID=12345
# WEAVE_BIRTH_CERT=<spawn-generated-certificate>
# CLAUDE_ENV_FILE=/tmp/claude-env

## Post-send hook child environment

# Generated by Weave for configured [[post_send_hook]] children. Do not set these
# in your shell; they are documented here as the child process contract.
# WEAVE_HOOK_EVENT=send
# WEAVE_HOOK_SENDER=desktop
# WEAVE_HOOK_RECIPIENT=envctl
# WEAVE_HOOK_SUBJECT=subject
# WEAVE_HOOK_MESSAGE_ID=42
# WEAVE_HOOK_BODY=message-body
# WEAVE_HOOK_PAYLOAD={"event":"send","sender":"desktop","recipient":"envctl","subject":"subject","message_id":42}

## Spawned peers and job runner child environment

# Remote/MCP spawn cwd allow-list. Empty/unset denies remote spawn.
# WEAVE_SPAWN_DIRS=/home/me/agents:/srv/work

# Generated for owned job runner processes. Set WEAVE_FXRUN_AGENT only when an
# external runner expects an agent selector; the rest are set by Weave.
# WEAVE_FXRUN_AGENT=codex
# WEAVE_JOB_ID=job_123
# WEAVE_ATTEMPT_ID=attempt_123
# WEAVE_WORKER=worker-a
# WEAVE_JOB_TITLE=Implement task
# WEAVE_JOB_PROMPT=Task prompt
# WEAVE_JOB_DESCRIPTION=Task description
# WEAVE_LEASES_JSON=[]
# WEAVE_POLICY_OWNER=weave

## Harness-generated environment

# ide-merge-ide harness. The Rust harness sets these for its delegated worker.
# WEAVE_WORKTREE=/path/to/weave-worktree
# WEAVE_BUDGET=1
# WEAVE_MAX_ITERS=1
# WEAVE_SLEEP=5
# WEAVE_MODEL=gpt-5
# WEAVE_AGENT_CMD=codex
# WEAVE_AGENT_MODEL_ARGS=
# WEAVE_APPLY=1
# WEAVE_KIMI_PLAN=1
# WEAVE_KIMI_REVIEW=1
# WEAVE_KIMI_CMD=kimi
# WEAVE_KIMI_MODEL=kimi-k2
# WEAVE_KIMI_SESSION=
# WEAVE_KIMI_SESSION_FLAG=
# WEAVE_KIMI_EXTRA_ARGS=

# forge-loop harness. The Rust harness sets these for codex exec.
# WEAVE_FORGE_WORKTREE=/path/to/weave-worktree
# WEAVE_FORGE_TASK=describe one cohesive task
# WEAVE_FORGE_BUDGET=1
# WEAVE_FORGE_MAX_ITERS=1
# WEAVE_FORGE_SLEEP=5
# WEAVE_FORGE_APPLY=1

## Provider-switch managed host env files

# `weave provider-switch` reads CC Switch provider rows and may write these names
# into host-specific config files. It does not read these API keys from this
# process env directly, but they are part of Weave-managed provider setup.
# OLLAMA_HOST=http://127.0.0.1:11434
# OPENAI_API_KEY=<secret-openai-compatible-provider-key>
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=<secret-anthropic-token>
# ANTHROPIC_MODEL=claude-sonnet-4
# GEMINI_API_KEY=<secret-gemini-api-key>
# GEMINI_MODEL=gemini-2.5-pro
# GOOGLE_GEMINI_MODEL=gemini-2.5-pro

## Explicitly gated live-test credentials

# These are only for the ignored live Turso integration test. CI does not set
# them and does not pass --ignored. Use a read-only token and a disposable DB.
# WEAVE_TEST_TURSO_URL=libsql://test-db.turso.io
# WEAVE_TEST_TURSO_TOKEN=<secret-read-only-test-token>
