{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.sh\"",
            "timeout": 15,
            "statusMessage": "Checking weave Codex environment"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/stop-summary.sh\"",
            "timeout": 15,
            "statusMessage": "Summarizing weave Codex workspace state"
          }
        ]
      }
    ]
  }
}
