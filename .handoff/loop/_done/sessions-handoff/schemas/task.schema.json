{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.task.v1",
  "title": "Handoff Task Card",
  "type": "object",
  "required": ["schema", "id", "title", "status", "priority", "objective", "path_scope", "acceptance_criteria", "test_commands"],
  "properties": {
    "schema": { "const": "handoff.task.v1" },
    "id": { "type": "string", "pattern": "^TASK-[0-9]{4,}$" },
    "title": { "type": "string", "minLength": 3 },
    "status": { "enum": ["backlog", "active", "claimed", "blocked", "checkpointed", "review", "done"] },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "objective": { "type": "string", "minLength": 10 },
    "path_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "test_commands": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" }, "default": [] },
    "blocked_by": { "type": "array", "items": { "type": "string" }, "default": [] },
    "allows_network": { "type": "boolean", "default": false },
    "allows_dependency_addition": { "type": "boolean", "default": false }
  },
  "additionalProperties": true
}
